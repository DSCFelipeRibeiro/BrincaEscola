# Repositório público: app, workflows, README e arquivos de schema/migração locais.
/*
!/.github/
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/DEV/
/DEV/*
!/DEV/app/
!/DEV/app/**
!/DEV/mariaDB/
/DEV/mariaDB/*
!/DEV/mariaDB/brincaescola_schema.sql
!/DEV/mariaDB/001_add_volante.sql
!/DEV/mariaDB/002_add_user_deletion_timestamp.sql

# Configurações locais e credenciais nunca são versionadas.
**/.env
**/.env.*
*.key
*.pem

# Artefatos locais e cópias operacionais.
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
PROD/
infra/
Onboarding/
